PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Resend (https://resend.com) — required for email reminders
RESEND_API_KEY=
EMAIL_FROM=TaskFlow <reminders@yourdomain.com>
# Optional: Redis for BullMQ. If empty, a MongoDB-backed server-side poller is used instead.
REDIS_URL=
# Optional: Web Push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
